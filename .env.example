# Binance Futures API Credentials
# IMPORTANT: Keep these secret! Add .env to .gitignore
# Create API keys at: https://www.binance.com/en/my/settings/api-management

# API Keys (required for paper trading data and live trading)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Testnet (optional, for testing without real money)
# Get testnet keys at: https://testnet.binancefuture.com/
BINANCE_TESTNET=false
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Safety: Set to true to prevent accidental live trading
DRY_RUN_OVERRIDE=false

# Logging
LOG_LEVEL=INFO

# Alerts (future enhancement)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=
